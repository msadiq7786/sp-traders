{
  "name": "server",
  "version": "1.0.0",
  "description": "Express backend for SP Traders.",
  "type": "module",
  "main": "dist/server.js",
  "_moduleAliases": {
    "@": "dist"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check",
    "format": "biome format --write"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.2",
    "better-auth": "^1.7.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "inngest": "^4.20.0",
    "module-alias": "^2.3.4",
    "mongodb": "^7.5.0",
    "mongoose": "^9.9.4",
    "morgan": "^1.11.0",
    "resend": "^6.26.0",
    "undici-types": "^8.3.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.3.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
